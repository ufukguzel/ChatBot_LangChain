# ============================================================
# LangChain Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- OpenAI API (required for real LLM calls) ---------------
# Leave empty or unset to use offline mock mode automatically.
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- LLM Defaults -------------------------------------------
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.4

# --- Force mock mode (1 = always use MockLLM) ---------------
FORCE_MOCK=0

# --- Web Server ---------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- CORS (comma-separated list of allowed origins) ---------
# For development, keep localhost origins.
# For production, restrict to your actual domain.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- File Upload Limits -------------------------------------
MAX_UPLOAD_MB=10

# --- Logging ------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
